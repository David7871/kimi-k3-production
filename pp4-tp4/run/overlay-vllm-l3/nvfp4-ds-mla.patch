+def _gather_dequant_nvfp4_ds_mla(
+    *,
+    src_cache: torch.Tensor,
+    dst: torch.Tensor,
+    block_table: torch.Tensor,
+    cu_seq_lens: torch.Tensor,
+    token_to_seq: torch.Tensor,
+    num_tokens: int,
+    seq_starts: torch.Tensor,
+) -> None:
+    """Correctness-first chunked-context gather for 432-byte NVFP4 records.
+
+    The compiled gather_and_maybe_dequant_cache kernel has no 432-byte
+    instantiation in this image, so prefill-with-context dequantizes in torch
+    instead. Decode (the hot path) never goes through here.
+
+    ``dst`` is BF16 ``[rows, kv_lora_rank + qk_rope_head_dim]``; the writer
+    quantizes with outer scale 1.0, so no latent scale is applied here.
+
+    Works for both the replicated and the decode-context-parallel context
+    gather: the caller passes the row->sequence map and the per-sequence start
+    in the same coordinate space as ``block_table``. Under DCP those are the
+    rank-local ones (``padded_local_cu_seq_lens``,
+    ``padded_local_token_to_seq``, ``chunk.starts`` == padded local starts and
+    the rank-local block table), so ``token_pos`` below is a local row offset
+    and indexes the local table exactly like
+    ``cp_gather_and_upconvert_fp8_kv_cache`` does for fp8_ds_mla.
+    """
+    toks = int(num_tokens)
+    if toks == 0:
+        return
+    if src_cache.ndim == 4:
+        assert src_cache.shape[2] == 1
+        src_cache = src_cache[:, :, 0, :]
+    assert src_cache.shape[-1] == 432, (
+        f"nvfp4_ds_mla expects 432-byte KV records, got {src_cache.shape[-1]}"
+    )
+    block_size = int(src_cache.shape[1])
+    records = src_cache.reshape(-1, 432)
+
+    seq = token_to_seq[:toks].to(device=dst.device, dtype=torch.long)
+    starts = seq_starts.to(device=dst.device, dtype=torch.long)
+    cu = cu_seq_lens.to(device=dst.device, dtype=torch.long)
+    # Position of output row t inside its sequence: chunk-local offset
+    # (t - cu_seq_lens[seq]) plus the sequence's context start.
+    token_pos = torch.arange(toks, device=dst.device) - cu[seq] + starts[seq]
+    pages = block_table.to(dst.device)[
+        seq, torch.div(token_pos, block_size, rounding_mode="floor")
+    ].to(torch.long)
+    rec = records[pages * block_size + token_pos % block_size]  # [toks,432] u8
+
+    packed = rec[:, :256]
+    codes = torch.stack((packed & 0xF, packed >> 4), dim=2).reshape(toks, 512)
