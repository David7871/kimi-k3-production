# Kimi-K3 QSRT-K2 (2-bit) PP4xTP4/DCP4 2-node — dense decode, no speculative decoding.
# TP4/DCP4 groups intra-node; PP boundaries cross bond0 via NCCL/RoCE.
# (Upstream copy also carried inert remote-draft lines, removed for this spec-free export.)
# --- RoCE fabric (qualified 2026-09-22) ---
NCCL_IB_DISABLE=0
NCCL_SOCKET_IFNAME=bond0
NCCL_IB_GID_INDEX=3
NCCL_IB_QPS_PER_CONNECTION=4
GLOO_SOCKET_IFNAME=bond0
NCCL_P2P_LEVEL=SYS
NCCL_PROTO=LL,LL128,Simple
NCCL_BUFFSIZE=2097152
NCCL_MAX_NCHANNELS=8
# --- source trees + JIT caches ---
PYTHONPATH=/opt/infernal-invocation/b12x:/opt/infernal-invocation/vllm
VLLM_SOURCE_OVERLAY_ACTIVE=1
HF_MODULES_CACHE=/cache/jit/hf-modules
TRITON_CACHE_DIR=/cache/jit/triton
# --- runtime tuning (from qualified qsrt launcher defaults) ---
CUTE_DSL_ARCH=sm_120a
CUDA_DEVICE_MAX_CONNECTIONS=32
CUDA_MODULE_LOADING=LAZY
CUDA_MODULE_DATA_LOADING=LAZY
OMP_NUM_THREADS=16
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
VLLM_WORKER_MULTIPROC_METHOD=spawn
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_ENABLE_PCIE_ALLREDUCE=0
VLLM_USE_B12X_FP8_GEMM=1
VLLM_USE_B12X_MOE=1
B12X_MOE_FORCE_A16=1
KDA_DISABLE_AUTOTUNE=1
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE=134217728
INSTANTTENSOR_BACKEND=AIO
INSTANTTENSOR_MAX_FREE_MEM_USAGE=0.6
SAFETENSORS_FAST_GPU=1
