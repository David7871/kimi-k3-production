# Absolute host directories. Download the pinned checkpoints before starting.
MODEL_DIR=/srv/models/Kimi-K3-QSRT-K2
DRAFT_MODEL_DIR=/srv/models/Kimi-K3-DFlash2
CACHE_DIR=/srv/kimi-k3/cache
LMCACHE_L2_DIR=/srv/kimi-k3/lmcache-l2

# Exact runtime snapshot; pull it or reconstruct it with the Dockerfile.
KIMI_IMAGE=ghcr.io/myshytf/kimi-k3:runtime-20260918

# Physical GPU IDs in TP-rank order on the reference host.
K3_GPU_ORDER=1,2,3,4,5,6,7,8,0
# Rank groups on the two PCIe switches. These are ranks, not physical GPU IDs.
K3_PCIE_GROUPS=0,1,2,3,8;4,5,6,7
# Production uses 1 on a Ryzen 7950X (16 cores / 32 threads).
# Keep 0 on another CPU until the affinity layout in runtime/serve_tp9.sh fits.
K3_CPU_PIN=0

PORT=8090
LMCACHE_PORT=5555
LMCACHE_HTTP_PORT=8088
LMCACHE_L1_GB=48
# Capacity is a ceiling, not a reservation. Match it to your disk capacity.
LMCACHE_L2_GB=2457.6
# Separate pool and namespace for this published recipe.
LMCACHE_SHM_NAME=kimik3_qsrt_public_20260918
LMCACHE_CACHE_NAMESPACE=qsrt-k2-tp9-kda-a3693719-lm98c8be0a
